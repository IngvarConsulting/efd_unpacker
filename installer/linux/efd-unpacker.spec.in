Name:           efd-unpacker
Version:        VERSION_PLACEHOLDER
Release:        1%{?dist}
Summary:        EFD Unpacker - Tool for unpacking EFD files
# Бинарь собран PyInstaller: код проекта под MIT, плюс вкомпилированные
# PyQt5 (GPLv3), Qt5 (LGPLv3), CPython (Python-2.0) и onec_dtools (MIT).
License:        MIT AND GPL-3.0-only AND LGPL-3.0-only AND Python-2.0
URL:            https://github.com/IngvarConsulting/efd_unpacker
Source0:        %{name}-%{version}.tar.gz
# Пакет содержит собранный x86_64 бинарь, а не переносимые скрипты,
# поэтому noarch здесь неверен. Интерпретатор вкомпилирован, отдельный
# python3 в зависимостях не нужен.
ExclusiveArch:  x86_64
Requires:       mesa-libGL
%description
EFD Unpacker is a tool for unpacking EFD (Enterprise File Distribution) files.
It provides both GUI and command-line interfaces.
%files
%defattr(-,root,root,-)
%license /usr/share/doc/efd-unpacker/copyright
/usr/bin/efd_unpacker
/usr/share/applications/efd_unpacker.desktop
/usr/share/icons/hicolor/256x256/apps/efd_unpacker.png
/usr/share/mime/packages/mime-info.xml
%post
update-desktop-database /usr/share/applications || :
update-mime-database /usr/share/mime || :
%postun
update-desktop-database /usr/share/applications || :
update-mime-database /usr/share/mime || :
