<?xml version="1.0" encoding="UTF-8"?>
<Wix
  xmlns="http://schemas.microsoft.com/wix/2006/wi"
  xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">
  <Bundle
    Name="EFD Unpacker"
    Version="VERSION_PLACEHOLDER"
    Manufacturer="Ingvar Consulting"
    UpgradeCode="9F4CE29E-8A3F-4B2A-A3D8-C9171E7D6F20"
    Compressed="yes"
    IconSourceFile="resources\icon.ico"
    DisableModify="yes">
    <BootstrapperApplicationRef
      Id="WixStandardBootstrapperApplication.RtfLicense"
      bal:UseUILanguages="yes">
      <bal:WixStandardBootstrapperApplication
        LicenseFile="installer\windows\license.rtf"
        LogoFile="resources\windows-setup-logo.bmp"
        ShowVersion="yes"
        SuppressRepair="yes" />

      <!-- Русские подписи мастера. Имя обязано быть ровно «1049\thm.wxl»:
           wixstdba ищет локализацию по пути «<папка BA>\<номер языка>\thm.wxl»,
           перебирая языки системы (locutil.cpp, LocProbeForFileEx), а под
           именем «thm.wxl» тема кладётся в бандл им самим (wixstdba.wxs).
           1049 — русский.

           Одного bal:UseUILanguages выше было мало: он выбирает из того, что
           в бандле ЕСТЬ, а WiX v3.14 кладёт у темы RtfLicense единственную
           локализацию, английскую. Папки по номерам языков в поставке WiX
           есть, но в них лежит mbapreq.wxl — диалог предусловий .NET,
           которым мы не пользуемся. -->
      <Payload
        Name="1049\thm.wxl"
        SourceFile="installer\windows\1049\thm.wxl"
        Compressed="yes" />
    </BootstrapperApplicationRef>

    <Chain>
      <MsiPackage
        Id="EFDUnpackerMsi"
        SourceFile="dist\efd-unpacker-VERSION_PLACEHOLDER-windows.msi"
        DisplayInternalUI="no"
        Visible="no">
        <MsiProperty Name="ADD_TO_PATH" Value="all" />
        <MsiProperty Name="ARPSYSTEMCOMPONENT" Value="1" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
