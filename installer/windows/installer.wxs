<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- UpgradeCode НЕ МЕНЯТЬ НИКОГДА. По нему Windows Installer узнаёт
       семейство продукта: смена рвёт цепочку обновления — новый MSI
       перестаёт видеть уже установленные версии.

       Прежнее значение, 12345678-1234-…, — заглушка из туториала по WiX.
       Любой чужой пакет, собранный по тому же шаблону, наш MajorUpgrade
       считал «предыдущей версией EFD Unpacker»: с меньшей версией молча
       сносил, с большей — обрывал установку сообщением, которое вдобавок
       врало про установленный продукт. -->
  <Product
    Id="*"
    Name="EFD Unpacker"
    Language="1033"
    Version="VERSION_PLACEHOLDER"
    Manufacturer="Ingvar Consulting"
    UpgradeCode="24200E4F-43B8-4B51-B5E3-34C8172A128B">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of EFD Unpacker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Condition Message="This application requires Windows 7 or later.">
      <![CDATA[Installed OR (VersionNT >= 601)]]>
    </Condition>

    <Property Id="ADD_TO_PATH" Value="all" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <Icon Id="AppIcon.ico" SourceFile="resources\icon.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="EFD Unpacker" />
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="EFD Unpacker" />
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Source="dist\EFDUnpacker.exe" KeyPath="yes" Id="EFDUnpackerEXE" Name="EFDUnpacker.exe" />

        <!-- Полные тексты лицензий рядом с приложением. GPL v3 требует,
             чтобы лицензия ехала ВМЕСТЕ с программой. Лежат в том же
             компоненте, что и exe: тот же каталог, та же судьба при
             удалении, а KeyPath у компонента один — сам exe. -->
        <File Source="licenses\GPL-3.0.txt" Id="LicenseGPL3" Name="GPL-3.0.txt" />
        <File Source="licenses\LGPL-3.0.txt" Id="LicenseLGPL3" Name="LGPL-3.0.txt" />
        <File Source="LICENSE" Id="LicenseMIT" Name="LICENSE.txt" />
        <File Source="build\BUILD-MANIFEST.txt" Id="LicenseManifest" Name="BUILD-MANIFEST.txt" />

        <!-- Свой тип файла. Имя с точкой — соглашение ProgId: так его не
             спутать с расширением, и два продукта не займут одно имя. -->
        <RegistryValue Root="HKCR" Key="EFDUnpacker.efd" Value="EFD Archive File" Type="string" />
        <RegistryValue Root="HKCR" Key="EFDUnpacker.efd\DefaultIcon" Value="[INSTALLFOLDER]EFDUnpacker.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="EFDUnpacker.efd\shell\open" Value="Open with EFD Unpacker" Type="string" />
        <RegistryValue Root="HKCR" Key="EFDUnpacker.efd\shell\open\command" Value="&quot;[INSTALLFOLDER]EFDUnpacker.exe&quot; &quot;%1&quot;" Type="string" />

        <!-- Себя в список доступных обработчиков, а не в значение по
             умолчанию ключа .efd.

             Прежняя запись перехватывала расширение безусловно. Целевая
             машина — с 1С:Предприятием, где .efd уже на что-то назначен:
             установка затирала прежний обработчик, а удаление уносило
             значение с собой, потому что Windows Installer прежнее не
             запоминает. Расширение оставалось вообще без программы.

             Теперь выбор за человеком: «Открыть с помощью» показывает нас
             наравне с тем, что стояло раньше. -->
        <RegistryValue Root="HKCR" Key=".efd\OpenWithProgids" Name="EFDUnpacker.efd" Value="" Type="string" />
        <RegistryValue Root="HKCR" Key=".efd" Name="Content Type" Value="application/x-efd" Type="string" />

        <RegistryValue Root="HKCR" Key="MIME\Database\Content Type\application/x-efd" Name="Extension" Value=".efd" Type="string" />
      </Component>

      <!-- Фиксированный GUID, а не «*»: KeyPath здесь каталог (CreateFolder),
           а для директорного KeyPath WiX v3 авто-GUID не выдаёт. Заморожен
           так же навсегда, как UpgradeCode. -->
      <Component Id="PathAllUsers" Guid="CD21D592-E806-4AD4-AAC8-AC50FD0EE017">
        <Condition>ADD_TO_PATH = "all"</Condition>
        <CreateFolder />
        <Environment
          Id="EFDUnpackerPathAllUsers"
          Name="PATH"
          Action="set"
          Part="last"
          Permanent="no"
          System="yes"
          Value="[INSTALLFOLDER]" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="EFD Unpacker"
          Description="EFD Unpacker Application"
          Target="[INSTALLFOLDER]EFDUnpacker.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\EFD Unpacker" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="EFD Unpacker"
          Description="EFD Unpacker Application"
          Target="[INSTALLFOLDER]EFDUnpacker.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\EFD Unpacker" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="EFD Unpacker" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="DesktopShortcutComponents" />
    </Feature>
  </Product>
</Wix>
