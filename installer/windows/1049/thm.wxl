<?xml version="1.0" encoding="utf-8"?>
<!--
  Русские подписи мастера установки (WixStandardBootstrapperApplication).

  Имя файла и папки продиктованы самим wixstdba, менять их нельзя. Он ищет
  локализацию по пути «<папка BA>\<номер языка>\thm.wxl», перебирая языки
  системы (locutil.cpp, LocProbeForFileEx), а «thm.wxl» — то имя, под которым
  тема кладётся в бандл (wixstdba.wxs: Payload Name='thm.wxl'). 1049 — русский.

  Строки и их идентификаторы взяты из RtfTheme.wxl WiX v3.14. Подстановки
  [WixBundleName] и [WixBundleVersion] и знаки «&» перед буквами быстрого
  доступа обязаны уцелеть: первые подставляет Burn, вторые — подчёркнутые
  буквы в кнопках.

  Текст лицензии остаётся английским намеренно: переводы GPL v3 не имеют
  юридической силы, и FSF просит распространять оригинал.
-->
<WixLocalization Culture="ru-ru" Language="1049" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="Caption">Установка [WixBundleName]</String>
  <String Id="Title">[WixBundleName]</String>
  <String Id="InstallVersion">Версия [WixBundleVersion]</String>
  <String Id="ConfirmCancelMessage">Прервать установку?</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">Прежняя версия</String>
  <String Id="HelpHeader">Справка по установщику</String>
  <String Id="HelpText">/install | /repair | /uninstall | /layout [каталог] — установить, восстановить, удалить
   или собрать полную локальную копию установщика в каталоге. По умолчанию — установка.

/passive | /quiet — показывать минимум окон без вопросов либо не показывать ничего
   и ни о чём не спрашивать. По умолчанию окна и вопросы показываются.

/norestart   — не перезагружать. По умолчанию установщик спросит перед перезагрузкой.
/log log.txt — писать журнал в указанный файл. По умолчанию журнал создаётся в %TEMP%.</String>
  <String Id="HelpCloseButton">&amp;Закрыть</String>
